default_platform(:ios)

desc "Build and upload a signed Dev or Prod archive using externally supplied credentials"
platform :ios do
  lane :upload_testflight do |options|
    environment = options.fetch(:environment, "dev").to_s
    UI.user_error!("environment must be dev or prod") unless %w[dev prod].include?(environment)
    destination = options.fetch(:destination, "ios").to_s
    UI.user_error!("destination must be ios or macos") unless %w[ios macos].include?(destination)
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE DEVELOPMENT_TEAM MATCH_GIT_URL MATCH_PASSWORD].each do |name|
      UI.user_error!("Missing #{name}") if ENV[name].to_s.empty?
    end
    UI.user_error!("DEVELOPMENT_TEAM must be a ten-character Apple team ID") unless ENV.fetch("DEVELOPMENT_TEAM").match?(/\A[A-Z0-9]{10}\z/)
    key_file = File.expand_path(ENV.fetch("ASC_KEY_FILE"))
    root = File.expand_path("..", __dir__)
    UI.user_error!("Keep the API private key outside the repository") if key_file.start_with?(root + File::SEPARATOR)
    UI.user_error!("ASC_KEY_FILE does not exist") unless File.file?(key_file)
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_file
    )
    bundle_id = "com.dm.routine.app.#{environment}"
    Dir.chdir(root) { sh("make", "gen") }
    signing_options = {
      type: "appstore", readonly: true, app_identifier: bundle_id, api_key: api_key,
      platform: destination == "macos" ? "catalyst" : "ios"
    }
    signing_options[:additional_cert_types] = ["mac_installer_distribution"] if destination == "macos"
    match(**signing_options)
    build_app(
      workspace: File.join(root, "Routine.xcworkspace"),
      scheme: "RoutineApp #{environment.capitalize}",
      configuration: "#{environment.capitalize}Release",
      export_method: "app-store",
      catalyst_platform: destination,
      xcargs: "DEVELOPMENT_TEAM=#{ENV.fetch('DEVELOPMENT_TEAM')}",
      output_directory: File.join(root, ".artifacts", destination)
    )
    upload_to_testflight(
      api_key: api_key, app_identifier: bundle_id,
      app_platform: destination == "macos" ? "osx" : "ios",
      skip_waiting_for_build_processing: true
    )
  end
end
